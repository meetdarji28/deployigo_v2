# Deployigo three-service local prototype defaults (customer/admin/API)
CUSTOMER_PORT=4300
ADMIN_PORT=4301
API_PORT=4302
PORTAL_BIND=127.0.0.1
API_BIND=127.0.0.1
# Legacy PORT is used only as the customer port when CUSTOMER_PORT is absent
SESSION_TTL_HOURS=8

# Default does NOT contact any SSH/Docker worker. For explicitly approved LAN testing,
# set DEPLOY_TARGET=remote-docker and configure the host's SSH credentials locally.
DEPLOY_TARGET=local-preview
DEPLOY_REMOTE_HOST=192.168.1.167
DEPLOY_REMOTE_USER=root
DEPLOY_REMOTE_BASE=/opt/deployigo/workspaces
DEPLOY_REMOTE_PORT_START=18080

# GitHub OAuth browsing is not a secure authenticated clone integration yet.
# Leave unset until a state-bound server-side OAuth + token storage design exists.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
